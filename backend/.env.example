# Backend Environment Variables Template
# Copy this file to .env for local development or configure these in Render.

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
DATABASE_URL=postgresql://your-db-url

# LLM (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Routing (OpenRouteService)
ROUTING_API_KEY=your_routing_api_key

# Auth
JWT_SECRET=your_secure_jwt_secret_min_16_chars

# App
# In production on Render, set NODE_ENV=production
NODE_ENV=development
# IMPORTANT: In production on Render, set CORS_ORIGIN to your Vercel frontend URL
# Example: https://my-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173
