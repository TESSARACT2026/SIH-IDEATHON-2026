# Frontend Environment Variables Template
# Copy this file to .env for local development or configure these in Vercel.

# Supabase configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API URL (Replace with your deployed Render backend URL in production)
# For example: https://your-backend-app.onrender.com/api/v1
# Default for local development is /api/v1 due to Vite proxy
VITE_API_BASE_URL=/api/v1

# Optional local auth redirect override. Leave blank to use current localhost origin.
VITE_AUTH_REDIRECT_URL=
